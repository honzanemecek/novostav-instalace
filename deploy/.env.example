# Environment for deploy/docker-compose.yml. Set these in Dokploy (app → Environment),
# never in the repo. Generate new secrets with: openssl rand -hex 32

# Public origin, no trailing slash, e.g. https://novostav-instalace.cz.
# Also passed to the image build: changing it needs a rebuild (Redeploy).
NEXT_PUBLIC_SERVER_URL=

# Hex only: it is put into the database connection URL as it is.
POSTGRES_PASSWORD=

# Reuse the value from Vercel. It encrypts the MCP API keys stored in the
# database; a new value invalidates them and logs everyone out.
PAYLOAD_SECRET=

PREVIEW_SECRET=
CRON_SECRET=

# Optional. Host directory for the nightly database dumps.
# BACKUP_DIR=/srv/novostav-backups
